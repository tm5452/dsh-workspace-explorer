{
  "name": "dsh-workspace-explorer",
  "version": "1.2.2-platform.1",
  "license": "MIT",
  "description": "Workspace browsing and previews in DeepSeek Harness Desktop, with experimental macOS and Linux support.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "pdfjs-dist": "5.6.205"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "scripts",
    "assets",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE-preview-extra"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "file-explorer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tm5452/dsh-workspace-explorer.git"
  },
  "homepage": "https://github.com/tm5452/dsh-workspace-explorer#readme"
}
