{
  "name": "dsh-workspace-explorer",
  "version": "1.0.0",
  "description": "Read-only Windows disk browsing and a persistent preview in DeepSeek Harness Desktop.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "scripts",
    "README.md",
    "LICENSE-preview-extra"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "file-explorer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tm5452/dsh-workspace-explorer.git"
  },
  "homepage": "https://github.com/tm5452/dsh-workspace-explorer#readme"
}
